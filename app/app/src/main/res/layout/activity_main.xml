<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- 顶部连接条 -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_dark_2"
        android:paddingLeft="12dp"
        android:paddingRight="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/topHost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/txt_dark"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="middle"
            android:text="—" />

        <Button
            android:id="@+id/btnReload"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_reload"
            android:textColor="@color/teal"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <Button
            android:id="@+id/btnChange"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_change"
            android:textColor="@color/txt_dark_2"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 首屏：填电脑地址 -->
        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@mipmap/ic_launcher_foreground"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/app_name"
                android:textColor="@color/txt_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/setup_title"
                android:textColor="@color/teal"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <RadioButton
                    android:id="@+id/rbDirect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_direct"
                    android:checked="true"
                    android:textColor="@color/txt_dark"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbRelay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:text="@string/mode_relay"
                    android:textColor="@color/txt_dark"
                    android:textSize="13sp" />
            </RadioGroup>

            <EditText
                android:id="@+id/relayHostInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:hint="@string/relay_hint"
                android:textColor="@color/txt_dark"
                android:textColorHint="@color/txt_dark_2"
                android:textSize="15sp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:inputType="textUri"
                android:importantForAutofill="no"
                android:singleLine="true"
                android:visibility="gone" />

            <EditText
                android:id="@+id/relaySecretInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="@string/relay_secret_hint"
                android:textColor="@color/txt_dark"
                android:textColorHint="@color/txt_dark_2"
                android:textSize="15sp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:singleLine="true"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/setup_sub"
                android:textColor="@color/txt_dark_2"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

            <EditText
                android:id="@+id/hostInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_input"
                android:hint="@string/setup_hint"
                android:textColor="@color/txt_dark"
                android:textColorHint="@color/txt_dark_2"
                android:textSize="15sp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:inputType="textUri"
                android:importantForAutofill="no"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button"
                android:text="@string/btn_connect"
                android:textColor="@color/bg_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="13dp"
                android:paddingBottom="13dp" />

            <TextView
                android:id="@+id/setupHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/txt_dark_2"
                android:textSize="11.5sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
